{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Gold",
          "slug": "primary",
          "color": "#C9A84C"
        },
        {
          "name": "Gold Light",
          "slug": "primary-lt",
          "color": "#E8D49A"
        },
        {
          "name": "Gold Dark",
          "slug": "primary-dk",
          "color": "#8B6914"
        },
        {
          "name": "Slate",
          "slug": "slate",
          "color": "#2E3440"
        },
        {
          "name": "Slate Mid",
          "slug": "slate-md",
          "color": "#4C566A"
        },
        {
          "name": "Slate Light",
          "slug": "slate-lt",
          "color": "#8C98A8"
        },
        {
          "name": "Cream",
          "slug": "cream",
          "color": "#F7F4EE"
        },
        {
          "name": "Ink",
          "slug": "ink",
          "color": "#0F0E0A"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.5rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "2.5rem"
        },
        {
          "name": "Huge",
          "slug": "huge",
          "size": "4rem"
        }
      ],
      "fontFamilies": [
        {
          "name": "Cormorant Garamond (Headings)",
          "slug": "serif",
          "fontFamily": "'Cormorant Garamond', Georgia, serif"
        },
        {
          "name": "DM Sans (Body)",
          "slug": "sans",
          "fontFamily": "'DM Sans', system-ui, sans-serif"
        },
        {
          "name": "DM Mono (Code)",
          "slug": "mono",
          "fontFamily": "'DM Mono', 'Courier New', monospace"
        }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "2rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "4rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "6rem"
        }
      ],
      "units": ["px", "em", "rem", "%", "vw", "vh"]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "#F7F4EE",
      "text": "#0F0E0A"
    },
    "typography": {
      "fontFamily": "'DM Sans', system-ui, sans-serif",
      "fontSize": "1rem",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#8B6914"
        },
        ":hover": {
          "color": {
            "text": "#C9A84C"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "'Cormorant Garamond', Georgia, serif",
          "fontWeight": "300",
          "lineHeight": "1.2",
          "letterSpacing": "-0.02em"
        },
        "color": {
          "text": "#2E3440"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "'Cormorant Garamond', Georgia, serif",
          "fontWeight": "300",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "#2E3440"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "'Cormorant Garamond', Georgia, serif",
          "fontWeight": "600"
        },
        "color": {
          "text": "#2E3440"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "#2E3440",
          "text": "#C9A84C"
        },
        "typography": {
          "fontSize": "0.8rem",
          "fontWeight": "500",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "core/quote": {
        "border": {
          "color": "#C9A84C",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "spacing": {
          "padding": {
            "left": "32px"
          }
        },
        "typography": {
          "fontFamily": "'Cormorant Garamond', Georgia, serif",
          "fontSize": "1.8rem",
          "fontStyle": "italic"
        },
        "color": {
          "text": "#2E3440"
        }
      },
      "core/heading": {
        "color": {
          "text": "#2E3440"
        }
      }
    }
  }
}
